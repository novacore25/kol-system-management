# Database connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kol_system

# TikTok Developers (Login Kit & Open API)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok/callback

# TikTok Shop Partner (TTSP / TTAP)
TIKTOK_SHOP_PARTNER_ID=your_partner_id
TIKTOK_SHOP_APP_KEY=your_app_key
TIKTOK_SHOP_APP_SECRET=your_app_secret

# App Config
NEXT_PUBLIC_APP_NAME="Creavy"
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=super_secret_jwt_key_change_in_production
